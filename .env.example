# MET Norway requires a unique application/domain identifier and real contact
# information. Replace this example before enabling the provider.
# MET_NORWAY_USER_AGENT=WeatherProject/0.1 https://example.com/contact

# Browser origins permitted to read API responses. Development allows all
# origins when this is absent; Vercel production requires an explicit value.
# CORS_ALLOWED_ORIGINS=https://sun.slpixe.com

# Abort provider and geocoding HTTP requests that exceed this duration.
# UPSTREAM_REQUEST_TIMEOUT_MS=10000

# Optional keyed providers. Providers only appear in the app when configured.
# VISUAL_CROSSING_API_KEY=replace-with-your-key
# OPENWEATHER_API_KEY=replace-with-your-key
# Adapter testing only. Production intentionally excludes WeatherAPI.com after
# unreliable live temperature results; do not re-enable without investigation.
# WEATHERAPI_API_KEY=replace-with-your-key
# PIRATE_WEATHER_API_KEY=replace-with-your-key
# TOMORROW_IO_API_KEY=replace-with-your-key
# Enable only when the configured Tomorrow.io plan exposes Timeline AQ fields.
# TOMORROW_IO_AIR_QUALITY_ENABLED=true
# WEATHERBIT_API_KEY=replace-with-your-key
# MET_OFFICE_API_KEY=replace-with-your-key

# Optional shared serverless cache and atomic provider-load budgets. Both
# Upstash values must be configured together. Without them, cache and budget
# counters are process-local.
# UPSTASH_REDIS_REST_URL=https://replace-with-your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-your-token
# Vercel's Upstash integration injects the equivalent KV_REST_API_URL and
# KV_REST_API_TOKEN variables automatically; the API accepts either pair.

# Count cache-miss provider loads per UTC day. Cached responses do not consume
# this budget. Keep multi-call adapters below their upstream call allowance.
# PROVIDER_DAILY_LOAD_BUDGETS={"met-office":100,"weatherbit":250}
