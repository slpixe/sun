{
  "name": "weather",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/**'",
    "build:storybook": "pnpm --filter @weather/web build-storybook",
    "dev": "pnpm build:packages && turbo run dev --filter='./apps/**'",
    "storybook": "pnpm --filter @weather/web storybook",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "vercel": "59.1.3"
  }
}
